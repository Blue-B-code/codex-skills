{
  "_comment": "Example configuration for the ticket-driver skill. Replace every value with your own. No real credentials are stored here — tokens/keys are read from this config at runtime and should never be committed.",
  "cron": {
    "codex_flags": "-s danger-full-access --dangerously-bypass-approvals-and-sandbox",
    "interval_minutes": 10
  },
  "projects": {
    "my-project-a": {
      "default_branch": "develop",
      "host": "gitlab",
      "me": "your-git-username",
      "mode": "propose",
      "project_id": 0,
      "project_path": "your-org/your-project",
      "redmine": {
        "project_id": 0,
        "recette_assignee": "Your Name",
        "recette_status": "A recetter"
      },
      "repo_dir": "~/your-project",
      "validation": {
        "backend": {
          "cmds": [
            "uv run pytest -q",
            "uv run ruff check .",
            "uv run mypy src"
          ],
          "dir": "backend"
        },
        "frontend": {
          "cmds": [
            "npx tsc --noEmit",
            "npm run lint -- --quiet",
            "npm run test"
          ],
          "dir": "frontend"
        }
      }
    },
    "my-project-b": {
      "default_branch": "develop",
      "host": "gitlab",
      "me": "your-git-username",
      "mode": "propose",
      "project_id": 0,
      "project_path": "your-org/your-other-project",
      "redmine": {
        "project_id": 0,
        "recette_assignee": "Your Name",
        "recette_status": "A recetter"
      },
      "repo_dir": "~/your-other-project",
      "validation": {
        "container": "your_dev_container",
        "frontend": {
          "cmds": [
            "npm run test:coverage",
            "npx tsc --noEmit",
            "npm run lint:quality"
          ],
          "workdir": "frontend"
        }
      }
    },
    "my-project-c": {
      "default_branch": "develop",
      "host": "redmine",
      "me": "your-git-username",
      "mode": "propose",
      "redmine": {
        "recette_assignee": "Your Name",
        "recette_status": "A recetter"
      },
      "repo_dir": "~/my-project-c"
    }
  },
  "rag": {
    "base_url": "https://your-rag-service.example.com",
    "enabled": false,
    "note": "Optional RAG backend used to generate specs from a ticket."
  },
  "redmine": {
    "api_key": "YOUR_REDMINE_API_KEY",
    "base_url": "https://your-redmine.example.com",
    "me": "Your Name",
    "me_id": 0,
    "project_id": 0,
    "sprint_prefix": "YourSprintPrefix",
    "sprint_routes": {
      "100": "my-project-a",
      "101": "my-project-b",
      "102": "my-project-c"
    },
    "sprint_scan_project_id": 0
  },
  "telegram": {
    "bot_token": "YOUR_TELEGRAM_BOT_TOKEN",
    "chat_id": 0,
    "poll_interval": 3
  }
}